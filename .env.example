# Local Ollama server. No API keys are involved: inference happens on your machine.
VITE_OLLAMA_HOST=http://localhost:11434
VITE_OLLAMA_MODEL=llama3.2:3b

# Optional. Point this at an installed vision model (for example llava:7b) if you
# want the fridge scanner to read the actual photo. Leave it unset otherwise.
# VITE_OLLAMA_VISION_MODEL=llava:7b
